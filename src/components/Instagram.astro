---
// Publicaciones reales de @inesita.cafe. Miniaturas guardadas localmente (las URL firmadas de Instagram caducan)
// y enlazadas a su publicación original. Actualizar a mano con nuevas publicaciones de vez en cuando,
// o sustituir por el embed de un servicio como LightWidget/SnapWidget para que se actualice solo.
const tiles = [
    { src: '/images/inesita/instagram/post-2.jpg', href: 'https://www.instagram.com/inesita.cafe/p/Dcf2MXJq9Kj/', alt: 'Anuncio del curso de latte art de Inesita' },
    { src: '/images/inesita/instagram/post-7.jpg', href: 'https://www.instagram.com/inesita.cafe/reel/Db5AWpxKo3e/', alt: 'Latte art y tosta de Inesita' },
    { src: '/images/inesita/instagram/post-6.jpg', href: 'https://www.instagram.com/inesita.cafe/reel/DcIsRelqDE7/', alt: 'Sirviendo un espresso en un vaso de Inesita' },
    { src: '/images/inesita/instagram/post-4.jpg', href: 'https://www.instagram.com/inesita.cafe/p/Db2VX_GCts5/', alt: 'El equipo de Inesita' },
    { src: '/images/inesita/instagram/post-5.jpg', href: 'https://www.instagram.com/inesita.cafe/reel/DcOKyRuqyBU/', alt: 'Preparando zumo natural en Inesita' },
    { src: '/images/inesita/instagram/post-3.jpg', href: 'https://www.instagram.com/inesita.cafe/p/DcdE2dJCsMu/', alt: 'Café del mes en Inesita' },
    // Fotos reales adicionales pasadas por Fátima, sin publicación concreta enlazada: apuntan al perfil.
    { src: '/images/inesita/real/vasos-inesita.jpg', href: 'https://instagram.com/inesita.cafe', alt: 'Vasos de Inesita apilados' },
    { src: '/images/inesita/real/bolsas-regalo.jpg', href: 'https://instagram.com/inesita.cafe', alt: 'Bolsas de Inesita para llevar' },
    { src: '/images/inesita/real/mano-vaso-pared.jpg', href: 'https://instagram.com/inesita.cafe', alt: 'Café para llevar de Inesita' }
];
---

<section id="instagram" class="bg-parchment">
    <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-12 lg:py-40">
        <div class="flex flex-col items-center text-center">
            <p class="eyebrow">Instagram</p>
            <h2 class="heading-display mt-5 text-subheading sm:text-heading-sm lg:text-heading">@inesita.cafe</h2>
            <p class="mx-auto mt-6 max-w-md text-sm text-muted sm:text-base">
                El día a día de la cafetería, novedades de carta y avisos de talleres, siempre en nuestro Instagram.
            </p>
            <a href="https://instagram.com/inesita.cafe" target="_blank" rel="noopener noreferrer" class="btn-ghost btn-ghost-light mt-8">
                Seguir en Instagram
            </a>
        </div>

        <div class="mt-16 grid grid-cols-2 gap-1 sm:grid-cols-3 lg:grid-cols-6">
            {
                tiles.map((tile) => (
                    <a
                        href={tile.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative block aspect-square overflow-hidden"
                    >
                        <img
                            src={tile.src}
                            alt={tile.alt}
                            loading="lazy"
                            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                        <div class="absolute inset-0 bg-roast/0 transition group-hover:bg-roast/20" />
                    </a>
                ))
            }
        </div>
    </div>
</section>

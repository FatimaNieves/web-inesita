<section id="contacto" class="bg-parchment">
    <div class="grid lg:grid-cols-2">
        <div class="relative min-h-[20rem] lg:min-h-[34rem]">
            <iframe
                title="Ubicación de Inesita Café de Especialidad"
                src="https://www.google.com/maps?q=Av.+da+Habana,+54,+32004+Ourense&output=embed"
                class="absolute inset-0 h-full w-full grayscale invert-[0.92] contrast-[1.05]"
                style="border:0;"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>

        <div class="flex flex-col justify-center gap-8 px-6 py-16 sm:px-12 sm:py-20 lg:px-16 lg:py-24">
            <div>
                <p class="eyebrow">Visítanos</p>
                <h2 class="heading-display mt-4 text-subheading sm:text-heading-sm">Inesita</h2>
            </div>

            <div class="flex flex-col gap-6">
                <div>
                    <p class="text-xs font-medium uppercase tracking-[0.15em] text-walnut">Dirección</p>
                    <p class="mt-1 text-base text-ink">Av. da Habana, 54-bajo · 32004 Ourense</p>
                </div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-[0.15em] text-walnut">Horario</p>
                    <p class="mt-1 text-base text-ink">Lunes a sábado · 8:30 – 20:30</p>
                    <p class="text-base text-ink">Domingo · 9:30 – 14:30</p>
                </div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-[0.15em] text-walnut">Contacto</p>
                    <p class="mt-1 text-base text-ink">
                        <a href="tel:+34617998152" class="transition hover:text-granate">617 99 81 52</a>
                        ·
                        <a href="https://instagram.com/inesita.cafe" target="_blank" rel="noopener noreferrer" class="transition hover:text-granate">
                            @inesita.cafe
                        </a>
                    </p>
                </div>
            </div>

            <div class="flex flex-wrap gap-4">
                <a
                    href="https://www.google.com/maps/dir/?api=1&destination=Av.+da+Habana,+54,+32004+Ourense"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-ghost border-granate bg-granate text-parchment hover:bg-granate-light hover:border-granate-light"
                >
                    Cómo llegar
                </a>
                <a href="mailto:hola@inesitacafe.es" class="btn-ghost border-ink text-ink hover:bg-ink hover:text-parchment">Escríbenos</a>
            </div>
        </div>
    </div>
</section>

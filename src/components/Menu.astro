---

<section id="carta" class="bg-linen">
    <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32 lg:px-12 lg:py-40">
        <div class="text-center">
            <p class="eyebrow text-center">La carta</p>
            <h2 class="heading-display mt-5 text-subheading sm:text-heading-sm lg:text-heading">Nuestra carta</h2>
            <p class="mx-auto mt-6 max-w-lg text-sm text-muted sm:text-base">
                Precios con IVA incluido. Descripciones y alérgenos disponibles en el establecimiento.
            </p>
        </div>

        <div class="mt-14">
            <div class="flex flex-wrap justify-center gap-2 sm:gap-3" role="tablist">
                {
                    categories.map((cat, i) => (
                        <button
                            type="button"
                            data-tab={cat.id}
                            aria-selected={i === 0}
                            class:list={[
                                'cursor-pointer rounded-[3px] border px-4 py-2.5 font-sans text-xs font-medium uppercase tracking-[0.1em] transition',
                                i === 0 ? 'border-granate bg-granate text-parchment' : 'border-hairline text-muted hover:border-ink hover:text-ink'
                            ]}
                        >
                            {cat.label}
                        </button>
                    ))
                }
            </div>

            {
                categories.map((cat, i) => (
                    <div class:list={['mt-12', { hidden: i !== 0 }]} data-panel={cat.id}>
                        <ul class="divide-y divide-hairline">
                            {cat.items.map((item) => (
                                <li class="flex gap-4 py-4">
                                    {item.image && (
                                        <img
                                            src={item.image}
                                            alt={item.name}
                                            loading="lazy"
                                            class="h-16 w-16 shrink-0 object-cover sm:h-20 sm:w-20"
                                        />
                                    )}
                                    <div class="min-w-0 grow">
                                        <div class="flex items-baseline justify-between gap-4">
                                            <p class="font-display text-lg text-ink sm:text-xl">{item.name}</p>
                                            <p class="shrink-0 whitespace-nowrap font-sans text-base font-semibold text-granate sm:text-lg">
                                                {item.price}
                                                {item.priceVariants?.map((v, vi) => (
                                                    <>
                                                        {vi > 0 && ' / '}
                                                        {v.price}
                                                    </>
                                                ))}
                                            </p>
                                        </div>

                                        {item.note && <p class="mt-1 text-xs uppercase tracking-[0.08em] text-walnut">{item.note}</p>}

                                        {item.options && <p class="mt-1 text-sm text-muted">{item.options.join(' · ')}</p>}

                                        {item.groupedOptions && (
                                            <ul class="mt-3 space-y-1.5">
                                                {item.groupedOptions.map((opt) => (
                                                    <li class="text-sm text-muted">
                                                        <span class="font-medium text-ink">{opt.name}:</span> {opt.desc}
                                                    </li>
                                                ))}
                                            </ul>
                                        )}
                                    </div>
                                </li>
                            ))}
                        </ul>

                        {cat.extras && (
                            <div class="mt-8 border-t border-hairline pt-6">
                                <p class="eyebrow text-[10px]">Extras</p>
                                <ul class="mt-3 space-y-2">
                                    {cat.extras.map((extra) => (
                                        <li class="flex items-baseline justify-between gap-4 text-sm text-muted">
                                            <span>{extra.name}</span>
                                            <span class="shrink-0 font-medium text-ink">{extra.price}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    const buttons = document.querySelectorAll('#carta [data-tab]');
    const panels = document.querySelectorAll('#carta [data-panel]');

    buttons.forEach((button) => {
        button.addEventListener('click', () => {
            const id = button.dataset.tab;

            buttons.forEach((b) => {
                const active = b === button;
                b.setAttribute('aria-selected', String(active));
                b.classList.toggle('border-granate', active);
                b.classList.toggle('bg-granate', active);
                b.classList.toggle('text-parchment', active);
                b.classList.toggle('border-hairline', !active);
                b.classList.toggle('text-muted', !active);
            });

            panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.panel !== id));
        });
    });
</script>
